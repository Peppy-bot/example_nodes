{
  schema_version: 1,
  manifest: {
    name: "fake_openarm01_brain",
    tag: "0.1.0",
    toolchain: "rust",
    labels: [
      "brain"
    ],
    add_cmd: [
      "cargo",
      "build",
      "--release"
    ],
    start_cmd: [
      "cargo",
      "run",
      "--release"
    ]
  },
  parameters: {},
  interfaces: {
    exposes: {
      topics: [],
      services: [],
      actions: [],
    },
    subscribes_to: {
      // The brain receives the inputs from the camera
      topics: [
        {
          id: "camera_front",
          node: "uvc_camera",
          name: "video_stream",
          tag: "0.1.0",
        }
      ],
      services: [
        {
          id: "camera_enable",
          node: "uvc_camera",
          name: "enable_camera",
          tag: "0.1.0",
        }
      ],
      // And emit actions for the controller to take
      actions: [
        {
          id: "move_right_arm_action",
          node: "openarm01_controller",
          name: "move_right_arm",
          tag: "0.1.0",
        },
        {
          id: "move_left_arm_action",
          node: "openarm01_controller",
          name: "move_left_arm",
          tag: "0.1.0",
        }
      ]
    },
  }
}
