{
  schema_version: 1,
  manifest: {
    name: "fake_video_reconstruction",
    tag: "0.1.0",
    language: "rust",
    add_cmd: [
      "cargo",
      "build",
      "--release"
    ],
    start_cmd: [
      "cargo",
      "run",
      "--release"
    ]
  },
  parameters: {
    // How long do you want the reconstruction to be?
    video_duration_seconds: "u32"
  },
  interfaces: {
    subscribes_to: {
      topics: [
        {
          id: "camera_stream",
          node: "fake_uvc_camera",
          tag: "0.1.0",
          name: "video_stream",
          integrity: "sha256:c036900c2f8e375cf97cd5c12b5642ae97ee4d0aed61ae44e7a38a4e0b1bbc2a"
        },
      ],
      services: [
        {
          id: "camera_info",
          node: "fake_uvc_camera",
          tag: "0.1.0",
          name: "video_stream_info",
          integrity: "3e61eb1eccfb7ee6fe48005558807e267bcce444bea5384897c86d1c900ec28e"
        },
      ]
    },
  }
}