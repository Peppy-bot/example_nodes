{
  schema_version: 1,
  manifest: {
    name: "fake_robot_brain",
    tag: "0.1.0",
    language: "python"
  },
  process: {
    add_cmd: [
      "uv",
      "sync",
      "--no-editable"
    ],
    start_cmd: [
      "./.venv/bin/python",
      "-m",
      "fake_robot_brain"
    ]
  },
  interfaces: {
    exposes: {
      topics: [],
      services: [],
      actions: [],
    },
    subscribes_to: {
      // The brain receives the inputs from the camera
      topics: [
        {
          id: "camera_stream",
          node: "fake_uvc_camera",
          name: "video_stream",
          tag: "0.1.0",
        }
      ],
      services: [
        {
          id: "video_info",
          node: "fake_uvc_camera",
          name: "video_stream_info",
          tag: "0.1.0",
        }
      ],
      // And emit actions for the controller to take
      actions: [
        {
          id: "move_right_arm_action",
          node: "fake_openarm01_controller",
          name: "move_right_arm",
          tag: "0.1.0",
        },
        {
          id: "move_left_arm_action",
          node: "fake_openarm01_controller",
          name: "move_left_arm",
          tag: "0.1.0",
        }
      ]
    },
  }
}